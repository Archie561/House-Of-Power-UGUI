  m_TableData:
  - m_Id: 26115268608
    m_Localized: "\u0414\u0443\u043D\u043A\u0430\u043D \u0424\u0435\u0440\u0431\u0435\u043D\u043A,\n\u0413\u043E\u043B\u043E\u0432\u0430
      \u0410\u0441\u043E\u0446\u0456\u0430\u0446\u0456\u0457 \u0444\u0435\u0440\u043C\u0435\u0440\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 361399541760
    m_Localized: "\u041C\u0430\u0439\u043A\u043B \u0411\u0435\u0440\u0442\u043E\u043D,\n\u041C\u0456\u043D\u0456\u0441\u0442\u0440
      \u041E\u0431\u043E\u0440\u043E\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 383881011200
    m_Localized: "\u0414\u0435\u0439\u043D \u0420\u043E\u0443\u0437,\n\u041C\u0456\u043D\u0456\u0441\u0442\u0440
      \u042E\u0441\u0442\u0438\u0446\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 414419738624
    m_Localized: "\u0412\u0456\u043D\u0441\u0435\u043D\u0442 \u0421\u0442\u043E\u043A\u0441,\n\u0413\u043E\u043B\u043E\u0432\u043D\u0438\u0439
      \u0414\u0438\u043F\u043B\u043E\u043C\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 472028504064
    m_Localized: "\u041A\u0435\u043B\u0441\u0456 \u041A\u0440\u0435\u0441\u0441,\n\u0415\u043A\u043E\u0430\u043A\u0442\u0438\u0432\u0456\u0441\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 516353908736
    m_Localized: "\u041F\u043E\u043B \u0421\u0430\u043B\u0432\u0456\u0434\u0436,\n\u041A\u0435\u0440\u0456\u0432\u043D\u0438\u043A
      \u0432\u0456\u0434\u0434\u0456\u043B\u0443 \u0415\u043A\u043E\u043D\u043E\u043C\u0456\u0447\u043D\u043E\u0433\u043E
      \u0420\u043E\u0437\u0432\u0438\u0442\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 548788461568
    m_Localized: "\u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D \u041F\u043E\u0440\u0442\u0435\u0440,\n\u041C\u0456\u043D\u0456\u0441\u0442\u0440
      \u041E\u0441\u0432\u0456\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 586008715264
    m_Localized: "\u0420\u0435\u0439 \u0411\u043E\u0439\u0434,\n\u0412\u0456\u0446\u0435-\u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 619470872576
    m_Localized: "\u041B\u043E\u0456\u0441 \u0411\u0435\u0440\u043D\u0441,\n\u041C\u0456\u043D\u0456\u0441\u0442\u0440
      \u041E\u0445\u043E\u0440\u043E\u043D\u0438 \u0417\u0434\u043E\u0440\u043E\u0432'\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 648587730944
    m_Localized: "\u0421\u0456\u0434\u043D\u0456 \u0420\u043E\u0434\u0436\u0435\u0440\u0441,\n\u0420\u0430\u0434\u043D\u0438\u043A
      \u0437 \u041F\u0438\u0442\u0430\u043D\u044C \u0406\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 697438789632
    m_Localized: "\u041E\u0442\u0456\u0441 \u0423\u043B\u044C\u0432\u0430,\n\u0411\u043E\u0436\u0435\u0432\u0456\u043B\u044C\u043D\u0438\u0439
      \u0412\u0447\u0435\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 718833934336
    m_Localized: "\u0414\u0436\u043E\u0430\u043D \u0424\u0440\u043E\u0441\u0442,\n\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u0421\u0443\u0441\u043F\u0456\u043B\u044C\u0441\u0442\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 68224978214912
    m_Localized: "\u041F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 9019956252860416
    m_Localized: "\u0412\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u044F \u041F\u043E\u043B\u0456\u0442\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 9138060307947520
    m_Localized: "\u041F\u0440\u0438\u0439\u043D\u044F\u0442\u0438"
