  - m_Id: 108944384000
    m_Localized: "\u0425\u0456\u043C\u0456\u0447\u043D\u0456 \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 353627496448
    m_Localized: "\u0417\u0430\u043B\u0456\u0437\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 384770203648
    m_Localized: "\u041C\u0456\u043D\u0435\u0440\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 444274794496
    m_Localized: "\u041D\u0430\u0444\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 465208565760
    m_Localized: "\u041A\u0430\u043C\u0456\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 495017484288
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3320524668624896
    m_Localized: "\u0414\u0456\u0430\u043C\u0430\u043D\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 18478162708488192
    m_Localized: "\u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18478254861541376
    m_Localized: "\u0406\u043D\u0444\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18478398331904000
    m_Localized: "\u041D\u0430\u0443\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18478447451398144
    m_Localized: "\u0415\u043A\u043E\u043B\u043E\u0433\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 18478491248320512
    m_Localized: "\u041E\u0441\u0432\u0456\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18478532843233280
    m_Localized: "\u0414\u043E\u0431\u0440\u043E\u0431\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 37593005576716288
    m_Localized: "\u0441\u0442\u0430\u043D \u0434\u043E\u0440\u0456\u0433 \u0442\u0430
      \u043A\u043E\u043C\u0443\u043D\u0456\u043A\u0430\u0446\u0456\u0439, \u043D\u0430\u044F\u0432\u043D\u0456\u0441\u0442\u044C
      \u0448\u043A\u0456\u043B, \u0443\u043D\u0456\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0456\u0432,
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432 \u0442\u0430 \u0456\u043D\u0448\u0438\u0445
      \u0437\u0440\u0443\u0447\u043D\u043E\u0441\u0442\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 37592907258036224
    m_Localized: "\u041B\u0456\u043A\u0430\u0440\u043D\u0456, \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u0432\u0438\u043B\u0456\u043A\u043E\u0432\u043D\u0438\u0445 \u0437\u0430\u0445\u0432\u043E\u0440\u044E\u0432\u0430\u043D\u044C,
      \u044F\u043A\u0456\u0441\u0442\u044C \u043B\u0456\u043A\u0430\u0440\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 37593083045511168
    m_Localized: "\u0440\u0456\u0432\u0435\u043D\u044C \u043D\u0430\u0443\u043A\u0438,
      \u0440\u043E\u0437\u0432\u0438\u0442\u043E\u043A \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0439,
      \u043A\u0456\u0431\u0435\u0440\u0431\u0435\u0437\u043F\u0435\u043A\u0430, \u0434\u0456\u0434\u0436\u0438\u0442\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 37593267984957440
    m_Localized: "\u0447\u0438\u0441\u0442\u043E\u0442\u0430 \u043D\u0430\u0432\u043A\u043E\u043B\u0438\u0448\u043D\u044C\u043E\u0433\u043E
      \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0430, \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      \u0437\u0430 \u0432\u0456\u0434\u0445\u043E\u0434\u0430\u043C\u0438, \u0437\u0430\u043F\u043E\u0431\u0456\u0433\u0430\u043D\u043D\u044F
      \u0435\u043A\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0438\u0445 \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 37593327862841344
    m_Localized: "\u044F\u043A\u0456\u0441\u0442\u044C \u043E\u0441\u0432\u0456\u0442\u0438
      \u0433\u0440\u043E\u043C\u0430\u0434\u044F\u043D, \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
      \u0448\u043A\u0456\u043B, \u0443\u043D\u0456\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0456\u0432,
      \u043A\u043E\u043B\u0435\u0434\u0436\u0456\u0432 \u0456 \u043D\u0430\u0432\u0447\u0430\u043B\u044C\u043D\u0438\u0445
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 37593375522717696
    m_Localized: "\u0440\u0456\u0432\u0435\u043D\u044C \u0436\u0438\u0442\u0442\u044F
      \u0433\u0440\u043E\u043C\u0430\u0434\u044F\u043D, \u043B\u0435\u0433\u0456\u0442\u0438\u043C\u043D\u0456\u0441\u0442\u044C
      \u0434\u043E \u0432\u043B\u0430\u0434\u0438, \u0437\u0430\u0433\u0430\u043B\u044C\u043D\u0435
      \u0436\u0438\u0442\u0442\u0454\u0432\u0435 \u0449\u0430\u0441\u0442\u044F"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
